RegionAtmosphere.DEFAULT = "Town"
RegionAtmosphere.TWEEN_TIME = 4

-- Which region contains `pos`? Highest Priority volume wins.
function RegionAtmosphere.regionAt(volumes: Instance?, pos: Vector3): string?
	if not volumes then
		return nil
	end
	local best: string? = nil
	local bestPriority = -math.huge
	for _, v in volumes:GetChildren() do
		if v:IsA("BasePart") then
			local prio = (v:GetAttribute("Priority") :: number?) or 0
			if prio > bestPriority then
				local inside: boolean
				if v:GetAttribute("Shape") == "Cylinder" then
					local r = (v:GetAttribute("Radius") :: number?) or v.Size.X / 2
					local d = Vector2.new(pos.X - v.Position.X, pos.Z - v.Position.Z).Magnitude
					inside = d <= r and math.abs(pos.Y - v.Position.Y) <= v.Size.Y / 2
				else
					local lp = v.CFrame:PointToObjectSpace(pos)
					local h = v.Size / 2
					inside = math.abs(lp.X) <= h.X and math.abs(lp.Y) <= h.Y and math.abs(lp.Z) <= h.Z
				end
				if inside then
					best = v:GetAttribute("Region") :: string?
					bestPriority = prio
				end
			end
		end
	end
	return best
end

return RegionAtmosphere
