--!strict
--[[
	Relics - the six faction weapons (vault: 03-Content/Relics). Each is upcycled from something
	the exporting cities threw away, and each story is a real kind of reuse. Rarity changes how a Relic
	plays, not how hard it hits (Pillar 1: skill over rarity): Legendaries have more utility, not
	more damage.

	Abilities (keys Z X C R B, Blacksmith tiers in Config/Economy) are built from a small set of
	kinds the server runs in ServerScriptService/Progression/RelicService:
	  Strike      box in front of the caster (range x width), `hits` times
	  Cone        arc in front (radius, angle); `pull` drags targets in, `follow` lands a second blow
	  Burst       circle around the caster (or at forward `offsets`), `pulses` times
	  Dash        the caster rushes `distance` over `duration`, hitting what it passes
	  Projectile  thrown object: `returns`, `bounces`, `count` + `spread`, `pierce`
	  Wave        a shockwave running along the ground (speed, range, width)
	  Leap        jump `distance` forward, burst on landing
	  Counter     a stance for `window` seconds; anyone who swings in it gets hit back
	  Guard       `reduction` of incoming damage for `duration`, optional hyper-armor
	  Heal        `heal` over `duration` to the caster and allies in `radius`
	  Aura        ticks around the caster for `duration` (damage enemies, heal allies)
	  Storm       a moving area that travels forward hitting every `interval`
	  Tidy        sorts the nearest salvage pile instantly (counts as salvaging)
	  Hop         a quick evasive hop back with i-frames
	`anim` names an entry in Shared/Config/Animations (unused since 2026-10-26: every move plays its
	own authored clip from Client/Progression/RelicAnimator). `fx.shape` picks the client effect.
	Every number is a PROPOSAL (2026-10-25); tune in play and update the vault.
]]

export type Fx = { shape: string, color: Color3, accent: Color3? }
export type Follow = { delay: number, radius: number, damage: number, posture: number, up: number?, knockback: number? }

export type Ability = {
	name: string,
	desc: string,
	kind: string,
	anim: string?,
	windup: number,
	lock: number, -- recovery: no other ability until windup + lock
	cooldown: number,
	ultimate: boolean?,
	damage: number?,
	posture: number?,
	knockback: number?,
	up: number?,
	stun: number?,
	ragdoll: number?,
	parryable: boolean?,
	blockable: boolean?,
	hits: number?,
	interval: number?,
	pulses: number?,
	grow: number?, -- extra radius per pulse
	range: number?,
	width: number?,
	radius: number?,
	angle: number?,
	offsets: { number }?,
	distance: number?,
	duration: number?,
	speed: number?,
	pierce: boolean?,
	returns: boolean?,
	bounces: number?,
	bounceRange: number?,
	count: number?,
	spread: number?,
	pull: number?,
	follow: Follow?,
	iframes: number?,
	armor: number?,
	reduction: number?,
	heal: number?,
	allyHeal: number?,
	suppress: number?, -- seconds the target's posture cannot recover
	window: number?,
	fx: Fx,
}

export type Relic = {
	id: string,
	name: string,
	faction: string,
	rarity: string,
	model: string, -- UI 3D icon and the in-hand model
	origin: string, -- what it was before
	lore: string,
	style: string, -- one-line playstyle
	abilities: { [string]: Ability },
}

