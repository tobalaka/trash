local Relics = {}
Relics.list = list
Relics.byId = {} :: { [string]: Relic }
Relics.byFaction = {} :: { [string]: { Relic } }
for _, j in list do
	Relics.byId[j.id] = j
	Relics.byFaction[j.faction] = Relics.byFaction[j.faction] or {}
	table.insert(Relics.byFaction[j.faction], j)
end
Relics.KEYS = { "Z", "X", "C", "R", "B" }

function Relics.get(id: string?): Relic?
	return if id then Relics.byId[id] else nil
end

return Relics
